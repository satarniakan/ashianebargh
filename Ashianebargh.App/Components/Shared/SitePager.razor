@* صفحه‌بندی مشترک سایت: شماره‌های صفحه با «…» برای فاصله‌ها. *@
@using Ashianebargh.App.Services
@inject SiteLanguage Language

<nav class="site-pager" aria-label="@Language["aria.pagination"]">
    @if (Page > 1)
    {
        <a class="site-page-btn" href="@UrlFor(Page - 1)">
            <i class="bi @Language.PreviousIcon"></i> @Language["pager.previous"]
        </a>
    }
    else
    {
        <span class="site-page-btn disabled" aria-disabled="true">
            <i class="bi @Language.PreviousIcon"></i> @Language["pager.previous"]
        </span>
    }

    @foreach (var item in Items())
    {
        if (item.Number is null)
        {
            <span class="site-pager-gap" aria-hidden="true">…</span>
        }
        else if (item.IsCurrent)
        {
            <span class="site-page-num on" aria-current="page">@item.Number</span>
        }
        else
        {
            <a class="site-page-num" href="@UrlFor(item.Number.Value)">@item.Number</a>
        }
    }

    @if (Page < TotalPages)
    {
        <a class="site-page-btn" href="@UrlFor(Page + 1)">
            @Language["pager.next"] <i class="bi @Language.NextIcon"></i>
        </a>
    }
    else
    {
        <span class="site-page-btn disabled" aria-disabled="true">
            @Language["pager.next"] <i class="bi @Language.NextIcon"></i>
        </span>
    }
</nav>

@code {
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public int TotalPages { get; set; } = 1;

    /// <summary>سازندهٔ لینک هر شمارهٔ صفحه.</summary>
    [Parameter, EditorRequired] public Func<int, string> UrlFor { get; set; } = default!;

    /// <summary>پنجرهٔ شماره‌ها (حداکثر ۵ عدد) با جداکننده برای فاصله‌ها.</summary>
    private IEnumerable<(int? Number, bool IsCurrent)> Items()
    {
        var total = Math.Max(1, TotalPages);
        var current = Math.Clamp(Page, 1, total);
        var start = Math.Max(1, current - 2);
        var end = Math.Min(total, current + 2);

        if (start > 1)
        {
            yield return (1, current == 1);
            if (start > 2) yield return (null, false);
        }

        for (var i = start; i <= end; i++)
        {
            yield return (i, i == current);
        }

        if (end < total)
        {
            if (end < total - 1) yield return (null, false);
            yield return (total, current == total);
        }
    }
}
