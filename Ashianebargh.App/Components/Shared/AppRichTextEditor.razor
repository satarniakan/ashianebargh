@* Ashianebargh.App/Components/Shared/AppRichTextEditor.razor *@
@* ادیتور متن غنی صفحات (Jodit)؛ خروجی HTML از طریق Value/ValueChanged همان مدل را می‌سازد *@
@using System.Linq.Expressions
@using Microsoft.AspNetCore.Components.Forms
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="@WrapperClass">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="form-label">@Label</label>
    }
    @* محتوای این div را Jodit می‌سازد؛ Blazor فقط ظرف خالی رندر می‌کند تا هنگام تایپ دست‌نخورده بماند.
       پوشش بیرونی dir را نگه می‌دارد تا نوار ابزار/پاپاپ‌ها جهت صفحه را به ارث ببرند. *@
    <div class="ash-jodit-editor" dir="@Direction">
        <div @ref="EditorElement"></div>
    </div>
    @if (CascadedEditContext is not null && ValueExpression is not null)
    {
        <ValidationMessage For="@ValueExpression" class="text-danger small mt-1 d-block" />
    }
    @if (!string.IsNullOrEmpty(Hint))
    {
        <div class="form-text">@Hint</div>
    }
</div>

@code {
    [CascadingParameter]
    private EditContext? CascadedEditContext { get; set; }

    private ElementReference EditorElement;
    private IJSObjectReference? _module;
    private DotNetObjectReference<AppRichTextEditor>? _dotNetRef;

    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? Hint { get; set; }
    [Parameter] public string WrapperClass { get; set; } = "mb-3";
    /// <summary>جهت پیش‌فرض خطوط: rtl برای فارسی، ltr برای انگلیسی.</summary>
    [Parameter] public string Direction { get; set; } = "rtl";

    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public Expression<Func<string?>>? ValueExpression { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // دارایی Jodit با ناوبری افزانه از سایت به پنل اجرا نمی‌شود؛ ماژول را همین‌جا تضمین کن.
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "/joditEditor.js");
            _dotNetRef = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("createEditor", EditorElement, _dotNetRef,
                new { value = Value ?? string.Empty, placeholder = Placeholder ?? string.Empty, direction = Direction });
        }
    }

    [JSInvokable]
    public async Task UpdateValue(string html)
    {
        // فقط تغییر واقعی را بالا بفرست؛ وگرنه حلقهٔ رندر/مقدار می‌سازد
        if (html != Value)
            await ValueChanged.InvokeAsync(html);
    }

    public async ValueTask DisposeAsync()
    {
        _dotNetRef?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("destroyEditor", EditorElement);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // مدار از قبل بسته است؛ تمیزکاری سمت JS دیگر معنا ندارد
            }
        }
    }
}
