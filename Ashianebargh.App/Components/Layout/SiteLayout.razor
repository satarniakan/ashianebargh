@* قالب عمومی سایت: سربرگ، منوی صفحات پویا و پابرگ. پنل مدیریت قالب جدا دارد. *@
@inherits LayoutComponentBase
@using Ashianebargh.Application.Content
@using Ashianebargh.Application.Services
@using Ashianebargh.Domain.Identity
@using Ashianebargh.App.Services
@inject AuthenticationStateProvider AuthStateProvider
@inject IServiceScopeFactory ScopeFactory
@inject NavigationManager Nav
@inject SiteLanguage Language

<div class="site-shell" dir="@Language.Dir" lang="@Language.Code" data-lang="@Language.Code">
    <a class="site-skip" href="#site-main">@T("nav.skipToContent")</a>
    <header class="site-header">
        <div class="site-header-inner">
            <a class="site-brand" href="/">
                <img class="site-brand-mark" src="/logo.png" alt="" width="44" height="44" />
                <span class="site-brand-text">
                    <span class="site-brand-name">@siteName</span>
                    <span class="site-brand-sub">@T("brand.tagline")</span>
                </span>
            </a>

            <nav class="site-nav" aria-label="@T("aria.mainMenu")">
                <a href="/" class="@NavClass("/")" aria-current="@AriaCurrent("/")">@T("nav.home")</a>
                <a href="/products" class="@NavClass("/products")" aria-current="@AriaCurrent("/products")">@T("nav.products")</a>
                @foreach (var item in menu)
                {
                    <a href="/@item.Slug" class="@NavClass("/" + item.Slug)" aria-current="@AriaCurrent("/" + item.Slug)">@(Language.IsEnglish ? item.TitleEn : item.Title)</a>
                }
                <a href="/about" class="@NavClass("/about")" aria-current="@AriaCurrent("/about")">@T("nav.about")</a>
                <a href="/contact" class="@NavClass("/contact")" aria-current="@AriaCurrent("/contact")">@T("nav.contact")</a>
            </nav>

            <div class="site-actions">
                <form class="site-search" method="get" action="/products" role="search">
                    <input class="site-search-input" type="search" name="q"
                           placeholder="@Language["search.placeholder"]" aria-label="@Language["search.placeholder"]"
                           value="@searchTerm" />
                    <button class="site-search-btn" type="submit" aria-label="@Language["search.button"]">
                        <i class="bi bi-search"></i>
                    </button>
                </form>
                <div class="site-tools">
                    <a class="site-tool site-tool-lang" href="@LanguageSwitchUrl"
                       data-lang-toggle="@(Language.IsEnglish ? "fa" : "en")"
                       title="@T("tool.language")" aria-label="@T("tool.language")">
                        @(Language.IsEnglish ? "فا" : "EN")
                    </a>
                    <button type="button" class="site-tool theme-toggle" data-theme-toggle
                            title="@T("tool.theme")" aria-label="@T("tool.theme")" aria-pressed="false">
                        <i class="bi bi-moon-stars-fill"></i>
                    </button>
                </div>

                <a class="site-cta" href="/contact">
                    <i class="bi bi-send-fill"></i>
                    <span>@T("action.quote")</span>
                </a>
                @if (isAuthenticated)
                {
                    <a class="site-login" href="/dashboard"><i class="bi bi-speedometer2"></i><span>@T("action.dashboard")</span></a>
                }
                else
                {
                    <a class="site-login" href="/login"><i class="bi bi-person"></i><span>@T("action.login")</span></a>
                }
            </div>
        </div>
    </header>

    <main class="site-main" id="site-main" tabindex="-1">
        @Body
    </main>

    <footer class="site-footer">
        <div class="site-footer-inner">
            <div class="site-footer-brand">
                <a class="site-brand" href="/">
                    <img class="site-brand-mark" src="/logo.png" alt="" width="42" height="42" />
                    <span class="site-brand-text">
                        <span class="site-brand-name">@siteName</span>
                    </span>
                </a>
                <p>@(contact?.WorkingHours ?? T("footer.fallback"))</p>
            </div>

            <div class="site-footer-info">
                @if (!string.IsNullOrWhiteSpace(contact?.Address))
                {
                    <div><i class="bi bi-geo-alt"></i><span>@contact.Address</span></div>
                }
                @if (!string.IsNullOrWhiteSpace(contact?.Phone))
                {
                    <div><i class="bi bi-telephone"></i><span dir="ltr">@contact.Phone</span></div>
                }
                @if (!string.IsNullOrWhiteSpace(contact?.Email))
                {
                    <div><i class="bi bi-envelope"></i><span dir="ltr">@contact.Email</span></div>
                }
            </div>

            <div class="site-footer-meta">
                <a class="site-footer-catalog" href="/media/catalog">
                    <i class="bi bi-file-earmark-arrow-down"></i>@T("footer.catalog")
                </a>
                <span>© @(Language.IsEnglish
                    ? DateTime.Now.Year.ToString(System.Globalization.CultureInfo.InvariantCulture)
                    : new System.Globalization.PersianCalendar().GetYear(DateTime.Now).ToString("0", System.Globalization.CultureInfo.InvariantCulture)) — @siteName</span>
            </div>
        </div>
    </footer>
</div>

@code {
    private string siteName = "آشیانه برق";
    private List<PageMenuItemDto> menu = new();
    private ContactInfoDto? contact;
    private bool isAuthenticated;
    private string searchTerm = string.Empty;

    private string T(string key) => Language[key];

    private string LanguageSwitchUrl
    {
        get
        {
            var target = Language.IsEnglish ? "fa" : "en";
            var current = "/" + Nav.ToBaseRelativePath(Nav.Uri);
            return $"/lang/{target}?returnUrl={Uri.EscapeDataString(current)}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Blazor SSR قالب را هم‌زمان با صفحه رندر می‌کند؛ اگر هر دو از DbContext مشترک
        // درخواست استفاده کنند خطای «second operation on this context» می‌دهند.
        // پس داده‌های قالب در scope جداگانه (DbContext جدا) خوانده می‌شوند.
        await using var scope = ScopeFactory.CreateAsyncScope();
        var settings = scope.ServiceProvider.GetRequiredService<ISettingService>();
        var pages = scope.ServiceProvider.GetRequiredService<IPageService>();
        var contacts = scope.ServiceProvider.GetRequiredService<IContactService>();

        siteName = await settings.GetAsync(FrameworkSettingKeys.SiteName) ?? "آشیانه برق";

        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        isAuthenticated = state.User.Identity?.IsAuthenticated == true;

        menu = await pages.GetMenuAsync();
        contact = await contacts.GetInfoAsync();

        // عبارت جست‌وجوی جاری از نشانی صفحه خوانده می‌شود تا داخل کادر جست‌وجو بماند.
        Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(Nav.Uri)
            .TryGetValue("q", out var q);
        searchTerm = q.ToString();
    }

    private string NavClass(string path) => IsActive(path) ? "on" : string.Empty;

    /// <summary>نشانهٔ صفحهٔ جاری برای صفحه‌خوان‌ها (aria-current).</summary>
    private string AriaCurrent(string path) => IsActive(path) ? "page" : null!;

    private bool IsActive(string path)
    {
        var current = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/');
        var target = "/" + path.Trim('/');

        if (target == "/")
        {
            return current == "/";
        }

        return current.Equals(target, StringComparison.OrdinalIgnoreCase)
               || current.StartsWith(target + "/", StringComparison.OrdinalIgnoreCase);
    }
}
