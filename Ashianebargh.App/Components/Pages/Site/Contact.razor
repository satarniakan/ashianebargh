@page "/contact"
@layout SiteLayout
@rendermode InteractiveServer
@using Ashianebargh.Application.Content
@using Ashianebargh.App.Services
@inject IContactService ContactService
@inject SiteLanguage Language
<PageTitle>@Language["contact.title"]</PageTitle>

<div class="site-container">
    <div class="site-page-head">
        <nav class="site-breadcrumb" aria-label="@Language["aria.breadcrumb"]">
            <a href="/">@Language["common.home"]</a>
            <span class="sep">/</span>
            <span class="current">@Language["contact.h1"]</span>
        </nav>
        <h1>@Language["contact.h1"]</h1>
        <p>@Language["contact.lead"]</p>
    </div>

    @if (info is null)
    {
        <div class="site-contact">
            <div class="site-panel">
                <LoadingSkeleton />
            </div>
        </div>
    }
    else
    {
        <div class="site-contact">
            <div class="site-panel">
                <div class="site-panel-title">
                    <span class="site-panel-icon"><i class="bi bi-geo-alt"></i></span>
                    @Language["contact.infoTitle"]
                </div>

                <div class="site-info-list">
                    @if (!string.IsNullOrWhiteSpace(info.Address))
                    {
                        <div class="site-info-item">
                            <i class="bi bi-geo-alt"></i>
                            <div>
                                <div class="site-info-label">@Language["contact.address"]</div>
                                <div class="site-info-value">@info.Address</div>
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(info.Phone))
                    {
                        <div class="site-info-item">
                            <i class="bi bi-telephone"></i>
                            <div>
                                <div class="site-info-label">@Language["contact.phone"]</div>
                                <div class="site-info-value"><a href="tel:@info.Phone" dir="ltr">@info.Phone</a></div>
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(info.Mobile))
                    {
                        <div class="site-info-item">
                            <i class="bi bi-phone"></i>
                            <div>
                                <div class="site-info-label">@Language["contact.mobile"]</div>
                                <div class="site-info-value"><a href="tel:@info.Mobile" dir="ltr">@info.Mobile</a></div>
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(info.Email))
                    {
                        <div class="site-info-item">
                            <i class="bi bi-envelope"></i>
                            <div>
                                <div class="site-info-label">@Language["contact.email"]</div>
                                <div class="site-info-value"><a href="mailto:@info.Email" dir="ltr">@info.Email</a></div>
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(info.WorkingHours))
                    {
                        <div class="site-info-item">
                            <i class="bi bi-clock"></i>
                            <div>
                                <div class="site-info-label">@Language["contact.hours"]</div>
                                <div class="site-info-value">@info.WorkingHours</div>
                            </div>
                        </div>
                    }
                </div>

                @if (socialLinks.Count > 0)
                {
                    <div class="site-social">
                        @foreach (var link in socialLinks)
                        {
                            <a href="@link.Url" target="_blank" rel="noopener noreferrer" title="@link.Title" aria-label="@link.Title">
                                <i class="bi @link.Icon"></i>
                            </a>
                        }
                    </div>
                }
            </div>

            <div class="site-panel site-form">
                <div class="site-panel-title">
                    <span class="site-panel-icon"><i class="bi bi-envelope-paper"></i></span>
                    @Language["contact.formTitle"]
                </div>

                @if (submitted)
                {
                    <div class="alert alert-success">
                        @Language["contact.success"]
                        <button class="btn btn-sm btn-outline-success ms-2" @onclick="() => submitted = false">@Language["contact.sendAnother"]</button>
                    </div>
                }

                @if (!submitted)
                {
                    <EditForm Model="form" OnValidSubmit="SubmitAsync">
                        <DataAnnotationsValidator />
                        <div class="site-form-grid">
                            <AppTextField Label="@Language["form.name"]" @bind-Value="form.Name" Required WrapperClass="site-field" />
                            <AppTextField Label="@Language["form.phone"]" @bind-Value="form.Phone" Required WrapperClass="site-field" />
                            <AppTextField Label="@Language["form.email"]" @bind-Value="form.Email" InputType="email" WrapperClass="site-field" />
                            <AppTextField Label="@Language["form.subject"]" @bind-Value="form.Subject" WrapperClass="site-field" />
                            <AppTextArea Label="@Language["form.message"]" @bind-Value="form.Message" Rows="5" Required ShowCount
                                         WrapperClass="site-field site-field--full" />
                        </div>

                        <button type="submit" class="btn btn-primary" disabled="@sending">
                            <i class="bi bi-send me-1"></i>
                            @(sending ? Language["form.sending"] : Language["form.send"])
                        </button>
                    </EditForm>
                }
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(MapUrl))
        {
            <div class="site-panel site-map">
                <div class="site-panel-title">
                    <span class="site-panel-icon"><i class="bi bi-map"></i></span>
                    @Language["contact.map"]
                </div>
                <iframe src="@MapUrl" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
                        title="@Language["contact.mapTitle"]"></iframe>
            </div>
        }
    }
</div>

@code {
    private ContactInfoDto? info;
    private ContactFormDto form = new();
    private readonly List<(string Title, string Icon, string Url)> socialLinks = new();
    private bool sending;
    private bool submitted;

    private string? MapUrl => ToHttpUrl(info?.MapUrl);

    [Inject] private IContactService Service { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        info = await Service.GetInfoAsync();

        AddSocial(Language["social.instagram"], "bi-instagram", info.Instagram);
        AddSocial(Language["social.telegram"], "bi-telegram", info.Telegram);
        AddSocial(Language["social.whatsapp"], "bi-whatsapp", info.WhatsApp);
    }

    private void AddSocial(string title, string icon, string? value)
    {
        var url = ToHttpUrl(value);
        if (url is not null) socialLinks.Add((title, icon, url));
    }

    /// <summary>ورودی ادمین را به آدرس امن http/https تبدیل می‌کند تا لینک javascript: ممکن نباشد.</summary>
    private static string? ToHttpUrl(string? value)
    {
        var trimmed = value?.Trim();
        if (string.IsNullOrWhiteSpace(trimmed)) return null;

        if (trimmed.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ||
            trimmed.StartsWith("http://", StringComparison.OrdinalIgnoreCase))
            return trimmed;

        return "https://" + trimmed.TrimStart('/');
    }

    private async Task SubmitAsync()
    {
        sending = true;
        try
        {
            await Service.SubmitAsync(form);
            form = new();
            submitted = true;
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ErrorMessageHelper.ToUserMessage(ex));
        }
        finally
        {
            sending = false;
        }
    }

    [Inject] private Ashianebargh.App.Services.ToastService ToastService { get; set; } = default!;
}
