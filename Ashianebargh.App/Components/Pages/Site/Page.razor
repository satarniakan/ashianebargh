@page "/{Slug}"
@attribute [AllowAnonymous]
@layout SiteLayout
@using Microsoft.AspNetCore.Http
@using Ashianebargh.Application.Content
@using Ashianebargh.App.Services
@inject IPageService PageService
@inject SiteLanguage Language

@if (view is null)
{
    @* چرا loading: رندر اولیهٔ SSR پیش از رسیدن داده انجام می‌شود؛ اگر NotFoundContent
       همان‌جا mount شود، حتی برای صفحهٔ موجودِ بعداً پیداشده ۴۰۴ می‌خورد (Soft-404). *@
    if (loading)
    {
        <PageTitle>…</PageTitle>
    }
    else
    {
        <PageTitle>@Language["page.notFoundTitle"]</PageTitle>
        <NotFoundContent From="@("/" + Slug)" />
    }
}
else
{
    var visual = PageVisual(view.Slug);

    <PageTitle>@Title | آشیانه برق</PageTitle>
    <SeoMeta Title="@Title"
             Description="@PageDescription" Path="@("/" + view.Slug)" Type="article" />

    <div class="site-container">
        <div class="site-page-head">
            <nav class="site-breadcrumb" aria-label="@Language["aria.breadcrumb"]">
                <a href="/">@Language["common.home"]</a>
                <span class="sep">/</span>
                <span class="current">@Title</span>
            </nav>
            <h1>@Title</h1>
        </div>

        @if (string.IsNullOrWhiteSpace(Body))
        {
            <div class="site-empty">
                <i class="bi bi-file-earmark-text"></i>
                <p>@Language["page.empty"]</p>
            </div>
        }
        else
        {
            <div class="site-page-body @(visual is null ? "site-page-body--plain" : null)">
                @if (visual is not null)
                {
                    <figure class="site-page-visual">
                        <img src="@visual" alt="@Title" />
                    </figure>
                }
                <div class="content-panel">
                    <RichContent Text="@Body" />
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    private PageViewDto? view;
    private bool loading = true;

    private string Title => LocalizedText.Pick(Language.IsEnglish, view?.TitleEn, view?.Title);

    private string? Body =>
        Language.IsEnglish && !string.IsNullOrWhiteSpace(view?.ContentEn) ? view.ContentEn : view?.Content;

    private string? PageDescription
    {
        get
        {
            var content = Body;
            if (string.IsNullOrWhiteSpace(content)) return Language["page.empty"];

            var text = System.Text.RegularExpressions.Regex.Replace(content, "<[^>]+>", " ");
            text = System.Net.WebUtility.HtmlDecode(text).Trim();
            text = System.Text.RegularExpressions.Regex.Replace(text, @"\s+", " ");
            return text.Length <= 160 ? text : text[..157].TrimEnd() + "…";
        }
    }

    private static readonly Dictionary<string, string> Visuals = new(StringComparer.OrdinalIgnoreCase)
    {
        ["garranty"] = "/images/pages/warranty.svg",
        ["warranty"] = "/images/pages/warranty.svg",
        ["guarantee"] = "/images/pages/warranty.svg",
        ["shipping"] = "/images/pages/shipping.svg",
        ["faq"] = "/images/pages/faq.svg"
    };

    private static string? PageVisual(string slug) => Visuals.GetValueOrDefault(slug);

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        view = await PageService.GetPublishedBySlugAsync(Slug);
        loading = false;
    }
}
