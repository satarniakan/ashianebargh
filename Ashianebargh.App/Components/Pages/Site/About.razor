@page "/about"
@layout SiteLayout
@using Ashianebargh.Application.Content
@using Ashianebargh.App.Services
@inject IPageService PageService
@inject SiteLanguage Language

@if (view is null)
{
    <PageTitle>@Language["about.title"]</PageTitle>
    <div class="site-container">
        <div class="site-empty">
            <i class="bi bi-info-circle"></i>
            <p>@Language["about.empty"]</p>
        </div>
    </div>
}
else
{
    <PageTitle>@(Language.IsEnglish ? view.TitleEn : view.Title) | آشیانه برق</PageTitle>

    <div class="site-container">
        <div class="site-page-head">
            <nav class="site-breadcrumb" aria-label="@Language["aria.breadcrumb"]">
                <a href="/">@Language["common.home"]</a>
                <span class="sep">/</span>
                <span class="current">@(Language.IsEnglish ? view.TitleEn : view.Title)</span>
            </nav>
            <h1>@(Language.IsEnglish ? view.TitleEn : view.Title)</h1>
        </div>

        @if (string.IsNullOrWhiteSpace(view.Content))
        {
            <div class="site-empty">
                <i class="bi bi-file-earmark-text"></i>
                <p>@Language["page.empty"]</p>
            </div>
        }
        else
        {
            <div class="content-panel">
                <ContentParagraphs Text="@(Language.IsEnglish ? view.ContentEn : view.Content)" />
            </div>
        }
    </div>
}

@code {
    private PageViewDto? view;

    protected override async Task OnInitializedAsync()
        => view = await PageService.GetAboutAsync();
}
