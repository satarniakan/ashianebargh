@page "/product/{Slug}"
@layout SiteLayout
@using Ashianebargh.Application.Content
@using Ashianebargh.Application.Helpers
@using Ashianebargh.App.Services
@inject IProductService ProductService
@inject ICategoryService CategoryService
@inject SiteLanguage Language

@if (product is null)
{
    <PageTitle>@Language["detail.notFoundTitle"]</PageTitle>
    <div class="site-container">
        <div class="site-empty">
            <i class="bi bi-box-seam"></i>
            <p>@Language["detail.notFound"]</p>
            <a href="/products" class="btn btn-sm btn-outline-secondary">@Language["detail.backToProducts"]</a>
        </div>
    </div>
}
else
{
    <PageTitle>@product.Name | آشیانه برق</PageTitle>

    <div class="site-container">
        <nav class="site-breadcrumb" aria-label="@Language["aria.breadcrumb"]">
            <a href="/">@Language["common.home"]</a>
            <span class="sep">/</span>
            <a href="/products">@Language["nav.products"]</a>
            <span class="sep">/</span>
            <a href="/products?category=@product.CategorySlug">@product.CategoryName</a>
            <span class="sep">/</span>
            <span class="current">@product.Name</span>
        </nav>

        <div class="site-detail-layout">
            <aside class="site-side">
                <div class="site-side-head"><h2>@Language["side.categories"]</h2></div>
                <nav class="site-side-nav" aria-label="@Language["aria.categories"]">
                    <a href="/products">
                        <span class="site-side-icon"><i class="bi bi-grid-3x3-gap"></i></span>
                        <span class="site-side-name">@Language["common.allProducts"]</span>
                    </a>
                    @foreach (var category in categories)
                    {
                        <a class="@(category.Slug == product.CategorySlug ? "on" : "")"
                           href="/products?category=@category.Slug">
                            <span class="site-side-icon"><i class="bi bi-diagram-3"></i></span>
                            <span class="site-side-name">@category.Name</span>
                            <span class="site-side-count">@category.ProductCount</span>
                        </a>
                    }
                </nav>
            </aside>

            <section class="site-panel">
                <div class="site-detail-top">
                    <div class="site-detail-info">
                        <span class="site-detail-cat"><i class="bi bi-diagram-3"></i>@product.CategoryName</span>
                        <h1 class="site-detail-title">@product.Name</h1>

                        @if (!string.IsNullOrWhiteSpace(product.Code))
                        {
                            <div class="site-detail-code">@Language["detail.codePrefix"] <b dir="ltr">@product.Code</b></div>
                        }

                        @if (!string.IsNullOrWhiteSpace(product.ShortDescription))
                        {
                            <p>@product.ShortDescription</p>
                        }

                        <div class="site-detail-price">
                            <i class="bi bi-tag"></i>
                            @(product.Price is null ? Language["detail.callForPrice"] : Language.FormatPrice(product.Price.Value))
                        </div>

                        @if (product.Tags.Count > 0)
                        {
                            <div class="site-detail-tags">
                                @foreach (var tag in product.Tags)
                                {
                                    <a href="/products?tag=@tag.Slug" class="site-tag">@tag.Name</a>
                                }
                            </div>
                        }

                        <div class="site-actions-row">
                            <a href="/contact" class="site-btn site-btn--red"><i class="bi bi-send"></i>@Language["detail.quote"]</a>
                            <a href="/products" class="site-btn site-btn--navy"><i class="bi bi-grid"></i>@Language["detail.other"]</a>
                        </div>
                    </div>

                    <div class="site-detail-media">
                        @if (!string.IsNullOrEmpty(product.MainImageStorageId))
                        {
                            <img src="/media/products/@product.MainImageStorageId" alt="@product.Name" />
                        }
                        else
                        {
                            <span class="site-detail-placeholder"><i class="bi bi-box-seam"></i></span>
                        }
                    </div>
                </div>

                <h2 class="site-subhead">@Language["detail.summary"]</h2>
                <div class="site-table-wrap">
                    <table class="site-table">
                        <thead>
                            <tr>
                                <th>@Language["detail.attribute"]</th>
                                <th>@Language["detail.value"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>@Language["detail.code"]</td>
                                <td class="ltr">@(string.IsNullOrWhiteSpace(product.Code) ? "—" : product.Code)</td>
                            </tr>
                            <tr>
                                <td>@Language["detail.category"]</td>
                                <td>@product.CategoryName</td>
                            </tr>
                            <tr>
                                <td>@Language["detail.price"]</td>
                                <td>@(product.Price is null ? Language["detail.callUs"] : Language.FormatPrice(product.Price.Value))</td>
                            </tr>
                            <tr>
                                <td>@Language["detail.tags"]</td>
                                <td>@(product.Tags.Count == 0 ? "—" : string.Join(Language.IsEnglish ? ", " : "، ", product.Tags.Select(t => t.Name)))</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                @if (!string.IsNullOrWhiteSpace(product.Description))
                {
                    <h2 class="site-subhead">@Language["detail.specs"]</h2>
                    @if (product.Description.TrimStart().StartsWith("<table", StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="site-table-wrap">
                            <div class="site-specs-wrap">
                                @((MarkupString)product.Description)
                            </div>
                            <p class="site-specs-hint">
                                <i class="bi bi-arrow-left-right"></i>
                                @(Language.IsEnglish ? "Swipe the table horizontally to see all columns." : "برای دیدن همهٔ ستون‌ها، جدول را افقی بکشید.")
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="site-detail-desc">
                            <ContentParagraphs Text="@product.Description" />
                        </div>
                    }
                }

                @if (product.Files.Count > 0)
                {
                    <h2 class="site-subhead">@Language["detail.files"]</h2>
                    <ul class="site-files">
                        @foreach (var f in product.Files)
                        {
                            <li class="site-file">
                                <span class="site-file-icon"><i class="bi bi-file-earmark-pdf"></i></span>
                                <span class="site-file-info">
                                    <span class="site-file-name" dir="ltr">@f.FileName</span>
                                    <span class="site-file-size">@Language.FileSize(f.SizeBytes)</span>
                                </span>
                                <a class="site-file-btn" href="/media/product-files/@f.Id/download">
                                    <i class="bi bi-download"></i>@Language["detail.download"]
                                </a>
                            </li>
                        }
                    </ul>
                }
            </section>
        </div>
    </div>
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    private ProductDetailsDto? product;
    private List<CategoryListItemDto> categories = new();

    protected override async Task OnParametersSetAsync()
    {
        product = await ProductService.GetPublicBySlugAsync(Slug);
        categories = await CategoryService.GetActiveAsync();
    }
}
