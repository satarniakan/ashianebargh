@page "/"
@layout SiteLayout
@using Ashianebargh.Application.Content
@using Ashianebargh.App.Services
@inject IProductService ProductService
@inject ICategoryService CategoryService
@inject SiteLanguage Language
<PageTitle>@Language["home.title"]</PageTitle>

<section class="site-hero">
    <div class="site-container site-hero-inner">
        <div class="site-hero-text">
            <div class="site-eyebrow">@Language["home.eyebrow"]</div>
            <h1>آشیانه <span>برق</span></h1>
            <p class="site-hero-lead">@Language["home.lead"]</p>
            <div class="site-hero-actions">
                <a class="site-btn site-btn--red" href="/products">
                    <i class="bi @Language.ForwardIcon"></i>
                    @Language["home.viewProducts"]
                </a>
                <a class="site-btn site-btn--ghost" href="/contact">
                    <i class="bi bi-headset"></i>
                    @Language["home.contact"]
                </a>
            </div>
        </div>

        <div class="site-hero-art" aria-hidden="true">
            <span class="site-hero-ring site-hero-ring--outer"></span>
            <span class="site-hero-ring site-hero-ring--inner"></span>
            <i class="bi bi-lightning-charge-fill"></i>
        </div>
    </div>
</section>

<section class="site-feats">
    <div class="site-container">
        <ul>
            <li>
                <span class="site-feat-icon"><i class="bi bi-boxes"></i></span>
                <span>@Language["feat.variety"]<small>@Language["feat.varietySub"]</small></span>
            </li>
            <li>
                <span class="site-feat-icon"><i class="bi bi-person-gear"></i></span>
                <span>@Language["feat.advice"]<small>@Language["feat.adviceSub"]</small></span>
            </li>
            <li>
                <span class="site-feat-icon"><i class="bi bi-truck"></i></span>
                <span>@Language["feat.shipping"]<small>@Language["feat.shippingSub"]</small></span>
            </li>
            <li>
                <span class="site-feat-icon"><i class="bi bi-shield-check"></i></span>
                <span>@Language["feat.support"]<small>@Language["feat.supportSub"]</small></span>
            </li>
        </ul>
    </div>
</section>

<div class="site-container">
    @if (categories.Count > 0)
    {
        <section class="site-section">
            <div class="site-section-head">
                <div class="site-section-title"><h2>@Language["home.categories"]</h2></div>
                <a class="site-more" href="/products">@Language["common.allProducts"] <i class="bi @Language.ForwardIcon"></i></a>
            </div>

            <div class="site-cats">
                @foreach (var category in categories)
                {
                    <a class="site-cat" href="/products?category=@category.Slug">
                        <span class="site-cat-media">
                            @if (!string.IsNullOrEmpty(category.ImageStorageId))
                            {
                                <img src="/media/products/@category.ImageStorageId" alt="" loading="lazy" />
                            }
                            else
                            {
                                <i class="bi bi-diagram-3"></i>
                            }
                        </span>
                        <span class="site-cat-name">@category.Name</span>
                        <span class="site-cat-meta">
                            <span>@Language.ProductCount(category.ProductCount)</span>
                            <span class="site-arrow"><i class="bi @Language.ForwardIcon"></i></span>
                        </span>
                    </a>
                }
            </div>
        </section>
    }

    <section class="site-section">
        <div class="site-section-head">
            <div class="site-section-title"><h2>@Language["home.featured"]</h2></div>
            <a class="site-more" href="/products">@Language["common.allProducts"] <i class="bi @Language.ForwardIcon"></i></a>
        </div>

        @if (featured.Count == 0)
        {
            <div class="site-empty">
                <i class="bi bi-box-seam"></i>
                <p>@Language["home.emptyFeatured"]</p>
            </div>
        }
        else
        {
            <div class="site-grid site-grid--4">
                @foreach (var product in featured)
                {
                    <ProductCardView Product="product" />
                }
            </div>
        }
    </section>
</div>

@code {
    private List<ProductCardDto> featured = new();
    private List<CategoryListItemDto> categories = new();

    protected override async Task OnInitializedAsync()
    {
        featured = await ProductService.GetFeaturedAsync(8);
        categories = await CategoryService.GetActiveAsync();
    }
}
