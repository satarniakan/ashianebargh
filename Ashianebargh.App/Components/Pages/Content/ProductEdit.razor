@page "/content/products/new"
@page "/content/products/{Id:int}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Ashianebargh.Domain.Content.ContentPermissions.Products)]
@using Microsoft.AspNetCore.Authorization
@using Ashianebargh.Application.Content
@using Ashianebargh.Domain.Content
@using Ashianebargh.Domain.Interfaces
<PageTitle>@(Id > 0 ? "ویرایش محصول" : "محصول جدید")</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">@(Id > 0 ? "ویرایش محصول" : "محصول جدید")</h3>
    <a href="/content/products" class="btn btn-sm btn-outline-secondary">بازگشت به فهرست</a>
</div>

@if (model is null)
{
    <div class="card-panel"><LoadingSkeleton /></div>
}
else
{
    <EditForm Model="model" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <div class="row g-3">
            <div class="col-lg-8">
                <div class="card-panel">
                    <div class="row">
                        <div class="col-md-8">
                            <AppTextField Label="نام محصول" @bind-Value="model.Name" />
                        </div>
                        <div class="col-md-4">
                            <AppTextField Label="کد محصول" @bind-Value="model.Code" />
                        </div>
                    </div>
                    <AppTextField Label="نامک (آدرس صفحه)" @bind-Value="model.Slug"
                                  Hint="خالی بگذارید تا از نام ساخته شود. باید یکتا باشد." />
                    <AppTextArea Label="توضیح کوتاه (کارت محصول)" @bind-Value="model.ShortDescription"
                                 Rows="2" ShowCount />
                    <AppRichTextEditor Label="توضیحات کامل" @bind-Value="model.Description" Direction="rtl"
                                       Placeholder="توضیحات محصول را بنویسید…"
                                       Hint="قالب‌بندی (پررنگ، عنوان، فهرست، جدول و…) در سایت همان‌طور نمایش داده می‌شود." />
                </div>

                <div class="card-panel mt-3">
                    <h5 class="mb-1">نسخهٔ انگلیسی (اختیاری)</h5>
                    <div class="form-text mb-3">
                        اگر خالی باشد، سایت در حالت انگلیسی همان متن فارسی را نشان می‌دهد.
                    </div>
                    <AppTextField Label="نام محصول (انگلیسی)" @bind-Value="model.NameEn" />
                    <AppTextArea Label="توضیح کوتاه (انگلیسی)" @bind-Value="model.ShortDescriptionEn"
                                 Rows="2" ShowCount />
                    <AppRichTextEditor Label="توضیحات کامل (انگلیسی)" @bind-Value="model.DescriptionEn" Direction="ltr"
                                       Placeholder="English product description…"
                                       Hint="متن انگلیسی نمایشی وقتی زبان سایت انگلیسی است." />
                </div>

                <div class="card-panel mt-3">
                    <h5 class="mb-3">برچسب‌ها</h5>
                    @if (tags.Count == 0)
                    {
                        <div class="text-body-secondary small">هنوز برچسبی تعریف نشده است.</div>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap gap-3">
                            @foreach (var tag in tags)
                            {
                                <label class="form-check mb-0">
                                    <input type="checkbox" class="form-check-input"
                                           checked="@model.TagIds.Contains(tag.Id)"
                                           @onchange="e => ToggleTag(tag.Id, (bool)(e.Value ?? false))" />
                                    <span class="form-check-label">@tag.Name</span>
                                </label>
                            }
                        </div>
                    }
                </div>

                <div class="card-panel mt-3">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0">مشخصات فنی</h5>
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddSpec">
                            <i class="bi bi-plus-lg me-1"></i>افزودن ردیف
                        </button>
                    </div>
                    @if (model.Specs.Count == 0)
                    {
                        <div class="text-body-secondary small">
                            ردیفی ثبت نشده است. این ردیف‌ها در سایت به‌صورت جدول «مشخصات محصول» نمایش داده می‌شوند.
                        </div>
                    }
                    else
                    {
                        @foreach (var (spec, index) in model.Specs.Select((s, i) => (s, i)).ToList())
                        {
                            <div class="row g-2 align-items-center mb-2">
                                <div class="col-4">
                                    <input class="form-control" placeholder="عنوان (مثلاً جنس بدنه)"
                                           value="@spec.Title" @onchange="e => SetSpecTitle(index, e.Value?.ToString())" />
                                </div>
                                <div class="col-6">
                                    <input class="form-control" placeholder="مقدار (مثلاً پلی‌کربنات)"
                                           value="@spec.Value" @onchange="e => SetSpecValue(index, e.Value?.ToString())" />
                                </div>
                                <div class="col-2 text-end">
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            title="حذف ردیف" @onclick="() => RemoveSpec(index)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card-panel">
                    <AppDropdown TValue="int" Label="دسته" @bind-Value="model.CategoryId">
                        <option value="0">— انتخاب دسته —</option>
                        @foreach (var c in categories)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </AppDropdown>

                    <div class="mb-3">
                        <label class="form-label">قیمت (تومان)</label>
                        <InputNumber class="form-control text-end" @bind-Value="model.Price"
                                     placeholder="خالی = تماس بگیرید" />
                        <ValidationMessage For="() => model.Price" class="text-danger small mt-1 d-block" />
                        <div class="form-text">خالی بگذارید تا در سایت «تماس بگیرید» نمایش داده شود.</div>
                    </div>

                    <AppNumberField TValue="int" Label="ترتیب نمایش" @bind-Value="model.SortOrder" />

                    <AppCheckbox Label="فعال (در سایت دیده شود)" @bind-Value="model.IsActive" />
                    <AppCheckbox Label="محصول ویژه (نمایش در صفحهٔ اول)" @bind-Value="model.IsFeatured" />
                </div>

                <div class="card-panel mt-3">
                    <h5 class="mb-3">تصویر اصلی</h5>
                    @if (!string.IsNullOrEmpty(ImagePreviewId))
                    {
                        <img src="/files/site-products/product-image/@ImagePreviewId" alt="@model.Name"
                             class="product-image-preview mb-3" />
                    }
                    else
                    {
                        <div class="text-body-secondary small mb-3">تصویری انتخاب نشده است.</div>
                    }
                    <div class="d-flex flex-wrap gap-2">
                        <label class="btn btn-sm btn-outline-primary mb-0" title="JPG، PNG یا WebP">
                            <i class="bi bi-upload me-1"></i>انتخاب تصویر
                            <InputFile accept=".jpg,.jpeg,.png,.webp,.gif" OnChange="UploadAsync" style="display:none;" />
                        </label>
                        @if (!string.IsNullOrEmpty(ImagePreviewId))
                        {
                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="RemoveImageAsync">حذف تصویر</button>
                        }
                    </div>
                    @if (uploading)
                    {
                        <div class="form-text mt-2">در حال بارگذاری…</div>
                    }
                </div>

                <div class="card-panel mt-3">
                    <h5 class="mb-3">گالری تصاویر</h5>
                    @if (model.Images.Count == 0 && pendingGallery.Count == 0)
                    {
                        <div class="text-body-secondary small mb-3">تصویر دیگری در گالری نیست.</div>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            @foreach (var image in model.Images)
                            {
                                <div class="position-relative">
                                    <img src="/files/site-products/product-image/@image.StorageId" alt="" width="72" height="72"
                                         class="rounded border" style="object-fit: cover;" loading="lazy" />
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger position-absolute top-0 end-0 m-1 py-0 px-1"
                                            title="حذف تصویر" @onclick="() => DeleteImageAsync(image.Id)">
                                        <i class="bi bi-x"></i>
                                    </button>
                                </div>
                            }
                            @foreach (var pending in pendingGallery)
                            {
                                <div class="position-relative">
                                    <img src="/files/site-products/product-image/@pending.StorageId" alt="" width="72" height="72"
                                         class="rounded border" style="object-fit: cover;" loading="lazy" />
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger position-absolute top-0 end-0 m-1 py-0 px-1"
                                            title="حذف تصویر" @onclick="() => RemovePendingGalleryAsync(pending.StorageId)">
                                        <i class="bi bi-x"></i>
                                    </button>
                                </div>
                            }
                        </div>
                    }
                    <label class="btn btn-sm btn-outline-primary mb-0" title="JPG، PNG یا WebP">
                        <i class="bi bi-upload me-1"></i>افزودن تصویر
                        <InputFile accept=".jpg,.jpeg,.png,.webp,.gif" multiple OnChange="UploadGalleryAsync" style="display:none;" />
                    </label>
                    @if (uploadingGallery)
                    {
                        <div class="form-text mt-2">در حال بارگذاری…</div>
                    }
                    <div class="form-text mt-2">
                        می‌توانید چند تصویر را یک‌جا انتخاب کنید (هر بار حداکثر ۱۰ تصویر، هر تصویر حداکثر ۵ مگابایت).
                        @if (model.Id == 0)
                        {
                            <text> تصاویر گالری پس از ذخیرهٔ محصول به آن وصل می‌شوند.</text>
                        }
                    </div>
                </div>

                <div class="card-panel mt-3">
                    <h5 class="mb-3">فایل‌های پیوست (PDF)</h5>
                    @if (model?.Files.Count > 0)
                    {
                        <ul class="list-group mb-3">
                            @foreach (var f in model!.Files)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span class="small">@f.FileName</span>
                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteFileAsync(f.Id)">حذف</button>
                                </li>
                            }
                        </ul>
                    }
                    @if (pendingFiles.Count > 0)
                    {
                        <ul class="list-group mb-3">
                            @foreach (var f in pendingFiles)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span class="small">@f.FileName <span class="text-body-secondary">(پس از ذخیرهٔ محصول پیوست می‌شود)</span></span>
                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemovePendingFileAsync(f.StorageId)">حذف</button>
                                </li>
                            }
                        </ul>
                    }
                    <label class="btn btn-sm btn-outline-primary mb-0" title="PDF">
                        <i class="bi bi-upload me-1"></i>پیوست فایل
                        <InputFile accept=".pdf" OnChange="UploadFileAsync" style="display:none;" />
                    </label>
                    @if (uploadingFile)
                    {
                        <div class="form-text mt-2">در حال بارگذاری…</div>
                    }
                </div>

                <div class="card-panel mt-3">
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary" disabled="@saving">@(saving ? "در حال ذخیره…" : "ذخیره")</button>
                        <a href="/content/products" class="btn btn-outline-secondary">انصراف</a>
                    </div>
                </div>
            </div>
        </div>
    </EditForm>
}

@code {
    [Parameter] public int Id { get; set; }

    private ProductEditDto? model;
    private List<CategoryListItemDto> categories = new();
    private List<TagListItemDto> tags = new();
    private string? pendingImageId;
    private readonly List<PendingFile> pendingFiles = new();
    private readonly List<PendingFile> pendingGallery = new();
    private bool saving;
    private bool uploading;
    private bool uploadingFile;
    private bool uploadingGallery;

    private sealed record PendingFile(string StorageId, string FileName, string ContentType, long SizeBytes);

    private const int MaxGalleryBatch = 10;

    private string? ImagePreviewId => pendingImageId ?? model?.MainImageStorageId;

    [Inject] private IProductService Service { get; set; } = default!;
    [Inject] private ICategoryService CategoryService { get; set; } = default!;
    [Inject] private ITagService TagService { get; set; } = default!;
    [Inject] private IFileStorage Storage { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private Ashianebargh.App.Services.ToastService ToastService { get; set; } = default!;

    protected override async Task OnParametersSetAsync()
    {
        categories = await CategoryService.GetAllAsync();
        tags = await TagService.GetAllAsync();

        if (Id > 0)
        {
            model = await Service.GetForEditAsync(Id);
            if (model is null)
            {
                ToastService.ShowError("محصول یافت نشد.");
                Navigation.NavigateTo("/content/products");
            }
        }
        else
        {
            model = new ProductEditDto();
        }
    }

    private void ToggleTag(int tagId, bool selected)
    {
        if (model is null) return;
        if (selected && !model.TagIds.Contains(tagId)) model.TagIds.Add(tagId);
        if (!selected) model.TagIds.Remove(tagId);
    }

    private void AddSpec()
    {
        model?.Specs.Add(new ProductSpecDto(string.Empty, string.Empty));
    }

    private void RemoveSpec(int index)
    {
        if (model is null || index < 0 || index >= model.Specs.Count) return;
        model.Specs.RemoveAt(index);
    }

    private void SetSpecTitle(int index, string? value)
    {
        if (model is null || index < 0 || index >= model.Specs.Count) return;
        model.Specs[index] = model.Specs[index] with { Title = value ?? string.Empty };
    }

    private void SetSpecValue(int index, string? value)
    {
        if (model is null || index < 0 || index >= model.Specs.Count) return;
        model.Specs[index] = model.Specs[index] with { Value = value ?? string.Empty };
    }

    private async Task UploadGalleryAsync(InputFileChangeEventArgs e)
    {
        if (model is null) return;
        if (e.FileCount > MaxGalleryBatch)
        {
            ToastService.ShowError($"در هر بار انتخاب حداکثر {MaxGalleryBatch} تصویر مجاز است.");
            return;
        }

        uploadingGallery = true;
        try
        {
            var added = 0;
            foreach (var file in e.GetMultipleFiles(MaxGalleryBatch))
            {
                await using var stream = file.OpenReadStream(5 * 1024 * 1024);
                if (model.Id > 0)
                {
                    var dto = await Service.AddImageAsync(model.Id, stream, file.Name);
                    model.Images.Add(dto);
                }
                else
                {
                    // محصول جدید: تصویر در فضای ذخیره‌سازی می‌نشیند و بعد از ذخیره وصل می‌شود
                    var storageId = await Storage.SaveAsync(
                        ContentStorage.Owner, ContentStorage.ProductImageType,
                        stream, file.Name, file.ContentType);
                    pendingGallery.Add(new PendingFile(storageId, file.Name, file.ContentType, file.Size));
                }
                added++;
            }

            ToastService.ShowSuccess(added == 1
                ? "تصویر به گالری اضافه شد."
                : $"{added} تصویر به گالری اضافه شد.");
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ErrorMessageHelper.ToUserMessage(ex));
        }
        finally
        {
            uploadingGallery = false;
        }
    }

    private async Task RemovePendingGalleryAsync(string storageId)
    {
        var pending = pendingGallery.FirstOrDefault(f => f.StorageId == storageId);
        if (pending is null) return;

        pendingGallery.RemoveAll(f => f.StorageId == storageId);
        try
        {
            await Storage.DeleteAsync(ContentStorage.Owner, ContentStorage.ProductImageType, storageId);
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ErrorMessageHelper.ToUserMessage(ex));
        }
    }

    private async Task DeleteImageAsync(int imageId)
    {
        if (model is null) return;
        try
        {
            await Service.DeleteImageAsync(imageId);
            model.Images.RemoveAll(i => i.Id == imageId);
            ToastService.ShowSuccess("تصویر حذف شد.");
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ErrorMessageHelper.ToUserMessage(ex));
        }
    }

    private async Task UploadAsync(InputFileChangeEventArgs e)
    {
        if (model is null) return;
        uploading = true;
        try
        {
            var file = e.File;
            await using var stream = file.OpenReadStream(5 * 1024 * 1024);
            var storageId = await Storage.SaveAsync(
                ContentStorage.Owner, ContentStorage.ProductImageType,
                stream, file.Name, file.ContentType);

            if (model.Id > 0)
            {
                // محصول موجود: جایگزینی فوری تا فایل قبلی هم پاک شود
                await Service.SetImageAsync(model.Id, storageId);
                model.MainImageStorageId = storageId;
                pendingImageId = null;
            }
            else
            {
                // محصول جدید: پس از ذخیره به آن وصل می‌شود
                pendingImageId = storageId;
            }

            ToastService.ShowSuccess("تصویر بارگذاری شد.");
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ErrorMessageHelper.ToUserMessage(ex));
        }
        finally
        {
            uploading = false;
        }
    }

    private async Task RemoveImageAsync()
    {
        if (model is null) return;
        try
        {
            if (model.Id > 0)
                await Service.SetImageAsync(model.Id, null);
            else if (pendingImageId is not null)
                await Storage.DeleteAsync(ContentStorage.Owner, ContentStorage.ProductImageType, pendingImageId);

            pendingImageId = null;
            model.MainImageStorageId = null;
            ToastService.ShowSuccess("تصویر حذف شد.");
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ErrorMessageHelper.ToUserMessage(ex));
        }
    }

    private async Task UploadFileAsync(InputFileChangeEventArgs e)
    {
        if (model is null) return;
        uploadingFile = true;
        try
        {
            var file = e.File;
            if (model.Id > 0)
            {
                // محصول موجود: فایل بلافاصله به آن وصل می‌شود
                await using var stream = file.OpenReadStream(20 * 1024 * 1024);
                var dto = await Service.AddFileAsync(model.Id, stream, file.Name, file.ContentType);
                model.Files.Add(dto);
            }
            else
            {
                // محصول جدید: فایل در فضای ذخیره‌سازی می‌نشیند و بعد از ذخیرهٔ محصول وصل می‌شود
                await using var stream = file.OpenReadStream(20 * 1024 * 1024);
                var storageId = await Storage.SaveAsync(
                    ContentStorage.Owner, ContentStorage.ProductFileType,
                    stream, file.Name, file.ContentType);
                pendingFiles.Add(new PendingFile(storageId, file.Name, file.ContentType, file.Size));
            }

            ToastService.ShowSuccess("فایل بارگذاری شد.");
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ErrorMessageHelper.ToUserMessage(ex));
        }
        finally
        {
            uploadingFile = false;
        }
    }

    private async Task RemovePendingFileAsync(string storageId)
    {
        var pending = pendingFiles.FirstOrDefault(f => f.StorageId == storageId);
        if (pending is null) return;

        pendingFiles.RemoveAll(f => f.StorageId == storageId);
        try
        {
            await Storage.DeleteAsync(ContentStorage.Owner, ContentStorage.ProductFileType, storageId);
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ErrorMessageHelper.ToUserMessage(ex));
        }
    }

    private async Task DeleteFileAsync(int fileId)
    {
        if (model is null) return;
        try
        {
            await Service.DeleteFileAsync(fileId);
            model.Files.RemoveAll(f => f.Id == fileId);
            ToastService.ShowSuccess("فایل حذف شد.");
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ErrorMessageHelper.ToUserMessage(ex));
        }
    }

    private async Task SaveAsync()
    {
        if (model is null) return;
        saving = true;
        try
        {
            var id = await Service.SaveAsync(model);
            if (pendingImageId is not null)
                await Service.SetImageAsync(id, pendingImageId);

            // فایل‌های آپلودشده پیش از ذخیرهٔ محصول، حالا به آن وصل می‌شوند.
            foreach (var pending in pendingFiles)
            {
                await Service.AttachFileAsync(id, pending.StorageId, pending.FileName,
                    pending.ContentType, pending.SizeBytes);
            }
            pendingFiles.Clear();

            foreach (var pending in pendingGallery)
                await Service.AttachImageAsync(id, pending.StorageId);
            pendingGallery.Clear();

            ToastService.ShowSuccess("محصول ذخیره شد.");
            Navigation.NavigateTo("/content/products");
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ErrorMessageHelper.ToUserMessage(ex));
        }
        finally
        {
            saving = false;
        }
    }
}
