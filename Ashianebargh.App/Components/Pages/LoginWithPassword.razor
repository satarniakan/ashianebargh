@page "/login-password"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]

<PageTitle>ورود با رمز عبور</PageTitle>

<div class="d-flex justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="card-panel" style="width: 100%; max-width: 420px;">
        <h3 class="text-center mb-4">ورود با نام کاربری و رمز عبور</h3>

        @if (ResetSuccess)
        {
            <div class="alert alert-success">رمز عبور با موفقیت تعیین شد. اکنون می‌توانید وارد شوید.</div>
        }

        @if (Error == "captcha")
        {
            <div class="alert alert-danger">اعتبارسنجی امنیتی ناموفق بود؛ دوباره تلاش کنید.</div>
        }
        else if (Error is not null)
        {
            <div class="alert alert-danger">نام کاربری یا رمز عبور اشتباه است.</div>
        }

        <form method="post" action="/Account/Login" data-enhance="false">
            <AntiforgeryToken />

            @* قالب ایمیل عمداً اعمال نمی‌شود: شناسهٔ ورود همان UserName است و می‌تواند
               شماره موبایل یا هر نام کاربری دیگر باشد؛ type="email" جلوی ارسال را می‌گرفت. *@
            <div class="mb-3">
                <label class="form-label" for="userName">نام کاربری</label>
                <input type="text" id="userName" name="userName" class="form-control"
                       autocomplete="username" spellcheck="false" required />
            </div>

            <div class="mb-4">
                <label class="form-label">رمز عبور</label>
                <input type="password" name="password" class="form-control" required />
            </div>

            <TurnstileWidget />

            <button type="submit" class="btn btn-primary w-100">ورود</button>
        </form>

        <p class="text-center text-muted mt-3 mb-0" style="font-size: 0.9rem;">
            <a href="/reset-password">رمز عبور را فراموش کرده‌اید؟</a>
        </p>

        <p class="text-center text-muted mt-2 mb-0" style="font-size: 0.9rem;">
            <a href="/login">ورود با شماره موبایل</a>
        </p>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "reset")]
    private string? Reset { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }

    private bool ResetSuccess => Reset == "success";
}
