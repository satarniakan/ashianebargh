@page "/admin/tks-import"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Ashianebargh.Domain.Content.ContentPermissions.Pages)]
@using Ashianebargh.Application.Content
@using Ashianebargh.App.Services
@inject ITksImportService ImportService
@inject Ashianebargh.App.Services.ToastService ToastService

<PageTitle>وارد کردن محصولات از tksterminal.com</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">وارد کردن محصولات از tksterminal.com</h3>
    <a href="/admin" class="btn btn-sm btn-outline-secondary">بازگشت به داشبورد</a>
</div>

<div class="card-panel">
    @if (isImporting)
    {
        <div class="alert alert-info">
            <i class="bi bi-hourglass-split me-2"></i> در حال دریافت و پردازش محصولات از tksterminal.com… لطفاً صبر کنید.
        </div>
    }
    else if (result is not null)
    {
        @if (result.Errors.Count > 0)
        {
            <div class="alert alert-warning">
                <h5>تکمیل شد با خطاها</h5>
                <p>واردشده: <strong>@result.Imported</strong> | به‌روزرسانی شده: <strong>@result.Updated</strong></p>
                <ul>
                    @foreach (var err in result.Errors)
                    {
                        <li>@err</li>
                    }
                </ul>
            </div>
        }
        else
        {
            <div class="alert alert-success">
                <h5>وارد کردن با موفقیت انجام شد</h5>
                <p>פרודוקטים جدید: <strong>@result.Imported</strong> | به‌روزرسانی شده: <strong>@result.Updated</strong></p>
            </div>
        }
    }

    <div class="mt-4">
        <button class="btn btn-primary" @onclick="ImportAsync" disabled="@isImporting">
            @(isImporting ? "در حال پردازش…" : "شروع وارد کردن محصولات")
        </button>
        <p class="text-body-secondary small mt-2">
            محصولات از <a href="https://tksterminal.com/" target="_blank" rel="noopener">tksterminal.com</a> دریافت و به صورت خودکار در سایت ذخیره می‌شوند.
            koska سایت مبدا API ندارد، این عملیات بر اساس استخراج HTML است و ممکن است نیاز به بازبینی دستی داشته باشد.
        </p>
    </div>
</div>

@code {
    private bool isImporting;
    private ImportResult? result;

    private async Task ImportAsync()
    {
        isImporting = true;
        result = null;
        try
        {
            result = await ImportService.ImportProductsAsync();
            if (result.Errors.Count == 0)
                ToastService.ShowSuccess($"وارد کردن تکمیل شد: {result.Imported} محصول جدید، {result.Updated} به‌روزرسانی.");
            else
                ToastService.ShowInfo($"وارد کردن با {result.Errors.Count} خطا انجام شد.");
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ErrorMessageHelper.ToUserMessage(ex));
        }
        finally
        {
            isImporting = false;
        }
    }
}