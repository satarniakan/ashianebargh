<?xml version="1.0" encoding="utf-8"?>
<!-- پیکربندی NuGet سطح ریپو (committed).
     چرا: با مدیریت متمرکز بسته‌ها (CPM)، وجود چند منبعِ نقشه‌نشده هشدار NU1507 می‌دهد و
     ریسک زنجیرهٔ تأمین دارد (یک mirror شخص ثالث می‌تواند بستهٔ متفاوتی سرو کند). اینجا
     منابع ماشین (mirrorهای محلی) پاک و تنها منبع معتبر nuget.org با نقشهٔ بسته تعریف می‌شود
     تا restore در CI و توسعه یکسان و قابل‌اتکا باشد. اگر به mirror محلی نیاز دارید، آن را
     با packageSourceMapping اضافه کنید (نه به‌صورت منبعِ نقشه‌نشده). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>