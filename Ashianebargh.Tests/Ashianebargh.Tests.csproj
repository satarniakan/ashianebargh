<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ashianebargh.Application\Ashianebargh.Application.csproj" />
    <ProjectReference Include="..\Ashianebargh.Domain\Ashianebargh.Domain.csproj" />
    <ProjectReference Include="..\Ashianebargh.Infrastructure\Ashianebargh.Infrastructure.csproj" />
    <ProjectReference Include="..\Ashianebargh.App\Ashianebargh.App.csproj" />
  </ItemGroup>

  <!-- فایل پیکربندی production برای تست رگرسیون سطح لاگ/محرمانه‌ها به خروجی تست کپی می‌شود
       تا مستقل از مسیر build (artifacts-path) قابل خواندن باشد. -->
  <ItemGroup>
    <Content Include="..\Ashianebargh.App\appsettings.Production.json" Link="appsettings.Production.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- فایل‌های زنجیرهٔ تأمین/استقرار برای تست‌های رگرسیون سخت‌سازی (SupplyChainHardeningTests).
         پروژهٔ ساخته‌شده از قالب، خودِ .template.config را ندارد (عمداً exclude شده)؛
         پس ارجاع باید شرطی باشد وگرنه build پروژهٔ قالبی می‌شکند. -->
    <Content Include="..\Directory.Packages.props" Link="Directory.Packages.props" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\NuGet.config" Link="NuGet.config" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\.github\workflows\ci.yml" Link="ci.yml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Ashianebargh.App\Dockerfile" Link="Dockerfile" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\.template.config\template.json" Link="template.json" CopyToOutputDirectory="PreserveNewest"
             Condition="Exists('..\.template.config\template.json')" />
  </ItemGroup>

</Project>