# مقادیر واقعی production — در گیت نمی‌رود (.gitignore). از .env.example کپی کنید.
MSSQL_SA_PASSWORD=ChangeMe_Strong123!
REDIS_PASSWORD=ChangeMe_Redis123!
APP_ADMIN_PHONE=09120000000
# دامنهٔ عمومی برای HTTPS خودکارِ proxy (پورت‌های 80/443 باید باز و DNS ست باشد)
APP_DOMAIN=example.com
# کلیدهای Cloudflare Turnstile (از داشبورد Turnstile). بدون آن‌ها استارتاپ متوقف می‌شود.
APP_TURNSTILE_SITE_KEY=0x4AAAAAAA_replace_me
APP_TURNSTILE_SECRET_KEY=0x4AAAAAAA_replace_me_secret
# نمک سمت سرور برای هش OTP/توکن؛ یک رشتهٔ تصادفی بلند (مثلاً openssl rand -hex 32)
APP_SECURITY_PEPPER=ChangeMe_RandomLongSecret
# اگر استقرار چندانتظیره دارید و می‌خواهید مایگریشن جدا از استارتاپ اجرا شود: false
APP_AUTO_MIGRATE=true
