# مقادیر واقعی production — در گیت نمی‌رود (.gitignore). از .env.example کپی کنید.
#
# چرا مقادیر پایین «REPLACE_ME» هستند و نه یک نمونهٔ واقع‌نما:
# گاردهای استارتاپ (ProductionGuards) هر مقداری را که نشانگر نمونه داشته باشد
# رد می‌کنند. اگر اینجا یک pepper یا شمارهٔ ادمینِ قابل‌استفاده بگذاریم، همان
# مقدار عمومیِ داخل ریپو به Production می‌رسد: pepper عمومی یعنی لو رفتن
# دیتابیس به‌تنهایی برای brute-force کافی است، و شمارهٔ ادمین نمونه یعنی
# هر دارندهٔ آن شماره Admin می‌شود. پس عمداً هیچ مقدار پیش‌فرضِ معتبری نداریم.

MSSQL_SA_PASSWORD=REPLACE_ME_StrongSqlPassword
REDIS_PASSWORD=REPLACE_ME_StrongRedisPassword

# شمارهٔ موبایل واقعیِ مدیر سامانه (قالب 09xxxxxxxxx). تنها راه ورود روی دیتابیس
# تازه است؛ خالی بماند compose با پیام روشن متوقف می‌شود. شمارهٔ نمونهٔ
# 09120000000 عمداً توسط گارد رد می‌شود.
APP_ADMIN_PHONE=

# دامنهٔ عمومی برای HTTPS خودکارِ proxy (پورت‌های 80/443 باید باز و DNS ست باشد)
APP_DOMAIN=REPLACE_ME_your-domain.com

# کلیدهای Cloudflare Turnstile (از داشبورد Turnstile). بدون آن‌ها استارتاپ متوقف می‌شود.
# کلید واقعی با «0x» شروع می‌شود؛ مقدار نمونه رد می‌شود.
APP_TURNSTILE_SITE_KEY=REPLACE_ME_0xTurnstileSiteKey
APP_TURNSTILE_SECRET_KEY=REPLACE_ME_0xTurnstileSecretKey

# نمک سمت سرور برای هش OTP/توکن؛ دست‌کم ۳۲ کاراکتر با ۸ کاراکتر متمایز.
# تولید: openssl rand -hex 32
APP_SECURITY_PEPPER=REPLACE_ME_RandomLongSecretAtLeast32Chars

# پیامک واقعی. با Fake در Production هیچ کدی ارسال نمی‌شود و ورود قفل می‌ماند.
APP_SMS_PROVIDER=Kavenegar
APP_KAVENEGAR_API_KEY=REPLACE_ME_KavenegarApiKey

# جانشینی ادمین پیش‌فرض خاموش است؛ فقط برای پنجرهٔ پشتیبانی روشن کنید.
APP_IMPERSONATION_ENABLED=false

# اگر استقرار چندنسخه‌ای دارید و می‌خواهید مایگریشن جدا از استارتاپ اجرا شود: false
APP_AUTO_MIGRATE=true

# گواهی SQL Server: پیش‌فرض true چون گواهی کانتینر self-signed است. با گواهی معتبرِ
# سازمانی (که کلاینت به آن اعتماد دارد) false کنید تا اعتبارسنجی TLS کامل شود.
APP_SQL_TRUST_CERT=true

# رمزنگاری کلیدهای DataProtection در حال سکون (اختیاری، دفاع لایه‌ای). مسیر یک گواهی
# دارای کلید خصوصی (PFX) که داخل کانتینر مونت شده باشد. خالی یعنی کلیدها plaintext روی
# ولوِل می‌مانند (دسترسی به ولوِل تقریباً هم‌سطح دسترسی به میزبان است). برای فعال‌سازی،
# فایل گواهی را مثلاً با یک volume/secrets به همان مسیر برسانید و این دو را پر کنید:
# APP_DATAPROTECTION_CERT_PATH=/run/secrets/dataprotection.pfx
# APP_DATAPROTECTION_CERT_PASSWORD=